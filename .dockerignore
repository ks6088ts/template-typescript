# Only build inputs may enter the context; tests, tooling, secrets and local output stay out.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!tsconfig.build.json
!src/
!src/**

# Secrets and generated output remain excluded even when nested under src.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules
**/dist
**/test
**/tests
**/scripts
**/coverage
**/*.tsbuildinfo
**/*.test.*
**/*.spec.*
**/__tests__
