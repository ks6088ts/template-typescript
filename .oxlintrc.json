{
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**"],
  "plugins": ["typescript", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "prefer-const": "error",
    "no-console": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  }
}
