{
  "name": "template-typescript",
  "version": "0.0.6",
  "private": true,
  "description": "A dependency-free TypeScript service template",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <27",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/12.11.2 ')) { process.stderr.write('Use pnpm@12.11.2\\n'); process.exitCode = 1; }\"",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "cli": "node src/bin/cli.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:strict": "pnpm lint",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "check:versions": "node scripts/check-versions.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "keywords": [],
  "author": "ks6088ts",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
